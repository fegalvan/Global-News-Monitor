# Copy to deploy/.env on the host. Generate a URL-safe secret with: openssl rand -hex 24
POSTGRES_PASSWORD=
# Public DNS name for HTTPS. For a local smoke test, set SITE_ADDRESS=:80 and BIND_ADDRESS=127.0.0.1.
SITE_ADDRESS=
GDELT_LOOKBACK_HOURS=24
GDELT_MAX_EXPORTS_PER_RUN=8
GDELT_RETENTION_DAYS=17
